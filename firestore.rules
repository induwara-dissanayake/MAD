rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════════
    // Helper Functions
    // ═══════════════════════════════════════════════════════════════════════════

    /// Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Check if user is admin or super_admin (from Firestore document)
    function isAdmin() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isAuthenticated() && (userRole == 'admin' || userRole == 'super_admin');
    }

    /// Check if user is the document owner
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /// Check if user's account is active
    function isAccountActive() {
      let accountStatus = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus;
      return accountStatus == 'active' || accountStatus == 'Active';
    }

    /// Check if user is GN Officer, Admin, or Super Admin
    function isOfficialOrAdmin() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isAuthenticated() &&
             (userRole == 'gn_officer' || userRole == 'admin' || userRole == 'super_admin');
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Users Collection Security Rules
    // ═══════════════════════════════════════════════════════════════════════════

    match /users/{userId} {

      // Admin/Super Admin: Can read ANY user document for management purposes
      allow read: if isAdmin();

      // Citizens/regular users: Can only read their own profile
      allow read: if isOwner(userId) && isAuthenticated();

      // Admin/Super Admin: Can update role and accountStatus fields
      // This is the primary use case for user management
      allow update: if isAdmin() && isAccountActive() &&
                      request.resource.data.keys().hasOnly(['role', 'accountStatus', 'updatedAt']);

      // Admin/Super Admin: Can update user with extended fields
      // Useful for profile updates during registration workflow
      allow update: if isAdmin() && isAccountActive() &&
                      request.resource.data.keys().hasOnly([
                        'role',
                        'accountStatus',
                        'updatedAt',
                        'fullName',
                        'phone',
                        'email',
                        'village',
                        'address'
                      ]);

      // Users can update their own lastLogin field
      allow update: if isOwner(userId) && isAuthenticated() &&
                      request.resource.data.keys().hasOnly(['lastLogin']);

      // Admin/Super Admin: Can create new user documents (for official registration)
      allow create: if isAdmin() && isAccountActive() &&
                       request.resource.data.keys().hasAll([
                         'fullName',
                         'nic',
                         'phone',
                         'email',
                         'role',
                         'createdAt'
                       ]);

      // Prevent deletion of user documents (soft delete only via accountStatus)
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Requests Collection (Certificate Requests)
    // ═══════════════════════════════════════════════════════════════════════════

    match /requests/{requestId} {

      // Citizens: Can read their own requests
      allow read: if isOwner(resource.data.citizenUid) && isAuthenticated();

      // GN Officers, Admins & Super Admins: Can read all requests
      allow read: if isOfficialOrAdmin();

      // Citizens: Can create requests
      allow create: if isOwner(request.resource.data.get('citizenUid', request.auth.uid)) &&
                       isAuthenticated();

      // GN Officers, Admins & Super Admins: Can update request status
      allow update: if isOfficialOrAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Certificate Request Results Collection
    // ═══════════════════════════════════════════════════════════════════════════

    match /certificaterq/{requestId} {

      // Citizens can read their own reviewed certificate records
      allow read: if isAuthenticated() &&
                    (isOfficialOrAdmin() || isOwner(resource.data.userId));

      // GN Officers, Admins & Super Admins can create reviewed records
      allow create: if isOfficialOrAdmin();

      // GN Officers, Admins & Super Admins can update reviewed records
      allow update: if isOfficialOrAdmin();

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Notifications Collection
    // ═══════════════════════════════════════════════════════════════════════════

    match /notifications/{notificationId} {

      // Users can read their own notifications only
      allow read: if isAuthenticated() && isOwner(resource.data.userId);

      // System/Authenticated users can create notifications
      allow create: if isAuthenticated();

      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() &&
                       isOwner(resource.data.userId) &&
                       request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead']);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Notices Collection (Public Notices)
    // ═══════════════════════════════════════════════════════════════════════════

    match /notices/{noticeId} {

      // Anyone authenticated can read notices
      allow read: if isAuthenticated();

      // Only admins can create/update/delete notices
      allow write: if isAdmin() && isAccountActive();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Default: Deny all other access
    // ═══════════════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
