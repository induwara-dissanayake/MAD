rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminOrOfficer() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'gn_officer'];
    }

    function currentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isCreatorForNewUser() {
      return isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.memberType in ['new_resident', 'family_member', 'rental']
        && (
          // GN Officer: can create resident-admin (new resident) and all citizen types.
          (
            currentUserRole() == 'gn_officer'
            && (
              (request.resource.data.role == 'admin_resident' && request.resource.data.memberType == 'new_resident')
              || request.resource.data.role == 'citizen'
            )
          )
          // Resident admin: can create citizens (new resident, family member, rental).
          || (
            currentUserRole() == 'admin_resident'
            && request.resource.data.role == 'citizen'
          )
          // Citizen: can create only family member / rental citizen records.
          || (
            currentUserRole() == 'citizen'
            && request.resource.data.role == 'citizen'
            && request.resource.data.memberType in ['family_member', 'rental']
          )
        );
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read profiles (for NIC-duplicate checks,
      // household member listing, admin panels, etc.)
      allow read: if true;

      // Owner self-create OR creator flow (GN/admin/resident creating another user profile).
      allow create: if (isSignedIn() && request.auth.uid == userId) || isCreatorForNewUser();

      // Owner can update their own document.
      allow update: if isOwner(userId);

      // Admins / GN officers can update any user (for role changes, etc.)
      allow update: if isAdminOrOfficer();

      // No deletion allowed.
      allow delete: if false;
    }

    // ── Outbound email queue (Firebase Trigger Email extension) ───────────
    match /mail/{mailId} {
      // Any authenticated creator can queue credential emails.
      allow create: if isSignedIn();

      // Prevent clients from reading or mutating queued emails.
      allow read, update, delete: if false;
    }

    // ── Citizen document requests / applications ─────────────────────────
    match /requests/{requestId} {
      // Citizen submits own request.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // Owner can read own requests, admins/officers can read all.
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdminOrOfficer()
        );

      // Review/status updates are officer/admin actions.
      allow update: if isAdminOrOfficer();

      // Deletion disabled to preserve audit history.
      allow delete: if false;
    }

    // ── Default deny ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
