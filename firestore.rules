rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════════
    // Helper Functions
    // ═══════════════════════════════════════════════════════════════════════════

    /// Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Check if user is admin.
    /// `super_admin` is treated as a legacy alias for backward compatibility.
    function isAdmin() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isAuthenticated() && (userRole == 'admin' || userRole == 'super_admin');
    }

    /// Check if user is the document owner
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /// Check ownership against common user-id field variants used in documents.
    function isRequestOwner(data) {
      return isAuthenticated() &&
             (
               isOwner(data.get('userId', '')) ||
               isOwner(data.get('citizenUid', '')) ||
               isOwner(data.get('uid', '')) ||
               isOwner(data.get('ownerUid', ''))
             );
    }

    /// Check if user's account is active
    function isAccountActive() {
      let accountStatus = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus;
      return accountStatus == 'active' || accountStatus == 'Active';
    }

    /// Check if user is GN Officer or Admin permissions.
    /// `super_admin` is treated as a legacy alias for admin.
    function isOfficialOrAdmin() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isAuthenticated() &&
             (userRole == 'gn_officer' || userRole == 'admin' || userRole == 'super_admin');
    }

    /// Check if current user is allowed to manage household members.
    function canManageHouseholdMembers() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isAuthenticated() &&
             (userRole == 'citizen' ||
              userRole == 'admin_resident' ||
              userRole == 'gn_officer' ||
              userRole == 'admin' ||
              userRole == 'super_admin');
    }

    /// Validate that a new user document is a household member profile.
    function isValidHouseholdMemberCreate() {
      return request.resource.data.get('createdByUid', '') == request.auth.uid &&
             request.resource.data.get('role', '') == 'citizen' &&
             (request.resource.data.get('memberType', '') == 'family_member' ||
              request.resource.data.get('memberType', '') == 'rental') &&
             request.resource.data.keys().hasAll([
               'fullName',
               'nic',
               'phone',
               'email',
               'address',
               'village',
               'district',
               'role',
               'memberType',
               'hasSystemAccess',
               'createdByUid',
               'createdAt'
             ]);
    }

    /// Check if requester is creator of target household member document.
    function isCreatorOfHouseholdMember() {
      return isAuthenticated() &&
             resource.data.get('createdByUid', '') == request.auth.uid &&
             resource.data.get('role', '') == 'citizen' &&
             (resource.data.get('memberType', '') == 'family_member' ||
              resource.data.get('memberType', '') == 'rental');
    }

    /// Ensure creator cannot rewrite ownership/type/role while updating member.
    function isSafeHouseholdMemberUpdate() {
      return request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '') &&
             request.resource.data.get('memberType', '') == resource.data.get('memberType', '') &&
             request.resource.data.get('role', '') == resource.data.get('role', '');
    }

    function isGnOfficer() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isAuthenticated() && userRole == 'gn_officer';
    }

    /// GN can read other users in the same village (notification fan-out query).
    function isSameVillageAsRequester() {
      return resource.data.get('village', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('village', '');
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Users Collection Security Rules
    // ═══════════════════════════════════════════════════════════════════════════

    match /users/{userId} {

      // Admin permissions: Can read any user document for management purposes
      allow read: if isAdmin();

      // GN officer: can read user profiles in their own village (e.g. village notification broadcast)
      allow read: if isGnOfficer() && isSameVillageAsRequester();

      // Citizens/regular users: Can only read their own profile
      allow read: if isOwner(userId) && isAuthenticated();

      // Household owner can read member profiles they created.
      allow read: if isCreatorOfHouseholdMember();

      // Admin permissions: Can update role and accountStatus fields
      // This is the primary use case for user management
      allow update: if isAdmin() && isAccountActive() &&
                      request.resource.data.keys().hasOnly(['role', 'accountStatus', 'updatedAt']);

      // Admin permissions: Can update user with extended fields
      // Useful for profile updates during registration workflow
      allow update: if isAdmin() && isAccountActive() &&
                      request.resource.data.keys().hasOnly([
                        'role',
                        'accountStatus',
                        'updatedAt',
                        'fullName',
                        'phone',
                        'email',
                        'village',
                        'address'
                      ]);

      // Users can update their own lastLogin field
      allow update: if isOwner(userId) && isAuthenticated() &&
                      request.resource.data.keys().hasOnly(['lastLogin']);

      // Household owner can update member profiles they created.
      allow update: if canManageHouseholdMembers() &&
              isCreatorOfHouseholdMember() &&
              isSafeHouseholdMemberUpdate();

      // Admins and officer-style creators can create new user documents
      allow create: if isAuthenticated() && isAccountActive() &&
                      (
                        isAdmin() ||
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gn_officer' ||
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin_resident'
                      ) &&
                      request.resource.data.keys().hasAll([
                        'fullName',
                        'nic',
                        'phone',
                        'email',
                        'role',
                        'createdAt'
                      ]);

      // Citizens/admin-residents can create family/rental members under their household.
      allow create: if canManageHouseholdMembers() && isValidHouseholdMemberCreate();

      // Prevent deletion of user documents (soft delete only via accountStatus)
      allow delete: if isAdmin() && isAccountActive() && request.auth.uid != userId;

      // Household owner can remove member profiles they created.
      allow delete: if canManageHouseholdMembers() && isCreatorOfHouseholdMember();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Requests Collection (Certificate Requests)
    // ═══════════════════════════════════════════════════════════════════════════

    match /requests/{requestId} {

      // Citizens: Can read their own requests
      allow read: if isRequestOwner(resource.data);

      // GN officers and admin permissions can read all requests
      allow read: if isOfficialOrAdmin();

      // Citizens: Can create requests
      allow create: if isRequestOwner(request.resource.data);

      // GN officers and admin permissions can update request status
      allow update: if isOfficialOrAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Certificate Request Results Collection
    // ═══════════════════════════════════════════════════════════════════════════

    match /certificaterq/{requestId} {

      // Citizens can read their own reviewed certificate records
      allow read: if isAuthenticated() &&
                    (isOfficialOrAdmin() || isRequestOwner(resource.data));

      // GN officers and admin permissions can create reviewed records
      allow create: if isOfficialOrAdmin();

      // GN officers and admin permissions can update reviewed records
      allow update: if isOfficialOrAdmin();

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Notifications Collection
    // ═══════════════════════════════════════════════════════════════════════════

    match /notifications/{notificationId} {

      // Users can read their own notifications only
      allow read: if isAuthenticated() && isOwner(resource.data.userId);

      // System/Authenticated users can create notifications
      allow create: if isAuthenticated();

      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() &&
                       isOwner(resource.data.userId) &&
                       request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead']);

      // Owner can delete their own notifications; admins may delete (moderation)
      allow delete: if isAuthenticated() &&
                      (isOwner(resource.data.userId) || (isAdmin() && isAccountActive()));
    }

    // ── Community Chats ──────────────────────────────────────────
    match /community_chats/{chatId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.senderId) || isOfficialOrAdmin();
    }

    // ── Community Chat Presence ──────────────────────────────────
    match /community_chat_presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isAuthenticated();
    }


    // ── Community Jobs ──────────────────────────────────────────
    match /community_jobs/{jobId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isOwner(resource.data.postedBy) || isOfficialOrAdmin();
    }

    // ── Community Complaints ──────────────────────────────────────────
    match /community_complaints/{complaintId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isOwner(resource.data.postedBy) || isOfficialOrAdmin();
    }

    // ── Community Lost & Found ──────────────────────────────────────────
    match /community_lost_found/{itemId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isOwner(resource.data.postedBy) || isOfficialOrAdmin();
    }

    // ── Default deny ─────────────────────────────────────────────
    // ═══════════════════════════════════════════════════════════════════════════
    // Notices Collection (Public Notices)
    // ═══════════════════════════════════════════════════════════════════════════

    match /notices/{noticeId} {

      // Anyone authenticated can read notices
      allow read: if isAuthenticated();

      // Only admins can create/update/delete notices
      allow write: if isAdmin() && isAccountActive();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Default: Deny all other access
    // ═══════════════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
